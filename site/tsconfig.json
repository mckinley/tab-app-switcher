{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./*"],
      "@tas/*": ["../tas/*"]
    },
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [".", "src/**/*.astro"],
  "exclude": ["dist", "node_modules"]
}
