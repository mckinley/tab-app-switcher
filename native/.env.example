# Release credentials for the native app and the Safari extension. Copy to .env (gitignored)
# and fill in; the values are in 1Password.

# GitHub token for publishing releases (github.com/settings/tokens/new, scope: repo)
GH_TOKEN=

# Notarizing the Mac app, and uploading Safari without an API key (Apple Developer account)
APPLE_ID=
# App-specific password from appleid.apple.com
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Safari: App Store Connect API key, which signs, uploads and submits the Safari extension for
# review (scripts/submit-safari.mjs). App Store Connect → Users and Access → Integrations → Team
# Keys → +, with Admin access (needed for Apple's cloud-managed signing certificates). Download
# the .p8 once and keep it out of the repo, for example in ~/.appstoreconnect/private_keys/.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absolute path to the downloaded AuthKey_XXXXXXXXXX.p8
ASC_KEY_PATH=

# Optional: Windows code signing
# CSC_LINK=path/to/certificate.pfx
# CSC_KEY_PASSWORD=
