# Store credentials for scripts/publish-*.sh. Copy to .env (gitignored) and fill in; the values are in 1Password.

# Chrome Web Store API Credentials
# Setup guide: See README.md

# Your OAuth Client ID (from Google Cloud Console -> Credentials)
CHROME_CLIENT_ID=

# Your OAuth Client Secret (from Google Cloud Console -> Credentials)
CHROME_CLIENT_SECRET=

# Your OAuth Refresh Token (from OAuth 2.0 Playground)
CHROME_REFRESH_TOKEN=

# Your Chrome Extension ID (from Chrome Web Store Developer Dashboard)
CHROME_EXTENSION_ID=mfcjanplaceclfoipcengelejgfngcan

# Your Publisher ID (from Chrome Web Store Developer Dashboard -> Account)
CHROME_PUBLISHER_ID=


# Firefox Add-ons (AMO) API Credentials
# Get credentials from: https://addons.mozilla.org/developers/addon/api/key/

# Your API Key (JWT issuer)
FIREFOX_API_KEY=

# Your API Secret (JWT secret)
FIREFOX_API_SECRET=


# Microsoft Edge Add-ons API Credentials
# Get credentials from: https://partner.microsoft.com/dashboard/microsoftedge/ -> Publish API

# Your Client ID
EDGE_CLIENT_ID=

# Your API Key
EDGE_API_KEY=

# Your Extension's Product ID (GUID format from Extension Identity, NOT the URL slug)
# Find it: Partner Center -> Your Extension -> Extension Identity -> Product ID
# Example format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EDGE_PRODUCT_ID=
